# syntax=docker/dockerfile:1

# IMPORTANT: keep Node in sync with the LTS version you build/test with.
ARG NODE_VERSION=24.13.0-slim

# ============================================
# Stage 1: Install dependencies
# Auto-detects the package manager from the lockfile:
# package-lock.json -> npm, yarn.lock -> yarn, pnpm-lock.yaml -> pnpm
# ============================================
FROM node:${NODE_VERSION} AS dependencies
WORKDIR /app

RUN corepack enable

# Copy manifests first to maximize layer caching
COPY package.json package-lock.json* yarn.lock* pnpm-lock.yaml* pnpm-workspace.yaml* .npmrc* ./

RUN --mount=type=cache,id=npm,target=/root/.npm \
    --mount=type=cache,id=yarn,target=/usr/local/share/.cache/yarn \
    --mount=type=cache,id=pnpm,target=/pnpm/store \
    if [ -f package-lock.json ]; then \
      npm ci --no-audit --no-fund; \
    elif [ -f yarn.lock ]; then \
      yarn install --frozen-lockfile; \
    elif [ -f pnpm-lock.yaml ]; then \
      pnpm install --frozen-lockfile; \
    else \
      echo "No lockfile found (package-lock.json / yarn.lock / pnpm-lock.yaml)." && exit 1; \
    fi

# ============================================
# Stage 2: Build the Next.js app (standalone)
# ============================================
FROM node:${NODE_VERSION} AS builder
WORKDIR /app

ENV NODE_ENV=production
# ENV NEXT_TELEMETRY_DISABLED=1

RUN corepack enable

COPY --from=dependencies /app/node_modules ./node_modules
COPY . .

RUN --mount=type=cache,id=npm,target=/root/.npm \
    --mount=type=cache,id=yarn,target=/usr/local/share/.cache/yarn \
    --mount=type=cache,id=pnpm,target=/pnpm/store \
    if [ -f package-lock.json ]; then \
      npm run build; \
    elif [ -f yarn.lock ]; then \
      yarn build; \
    elif [ -f pnpm-lock.yaml ]; then \
      pnpm build; \
    else \
      echo "No lockfile found." && exit 1; \
    fi

# ============================================
# Stage 3: Minimal runtime image
# ============================================
FROM node:${NODE_VERSION} AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
# ENV NEXT_TELEMETRY_DISABLED=1

# Static assets and public files are not traced into standalone by default
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static

# Writable cache dir for the non-root user (ISR / image optimization)
RUN mkdir -p .next/cache && chown -R node:node .next

USER node

EXPOSE 3000

# Standalone server.js is generated by `output: "standalone"`
CMD ["node", "server.js"]
